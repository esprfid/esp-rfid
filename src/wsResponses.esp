void ICACHE_FLASH_ATTR sendUserList(int page, AsyncWebSocketClient *client)
{
	DynamicJsonDocument root(3072);
	root["command"] = "userlist";
	root["page"] = page;
	JsonArray users = root.createNestedArray("list");
	EspRfidDir dir("/P/");
	int first = (page - 1) * 10;
	int last = page * 10;
	int i = 0;
	while (dir.next())
	{
		if (i >= first && i < last)
		{
			JsonObject item = users.createNestedObject();
			String uid = dir.fileName();
			uid.remove(0, 3);
			item["uid"] = uid;
			File f = SPIFFS.open(dir.fileName(), "r");
			size_t size = f.size();
			std::unique_ptr<char[]> buf(new char[size]);
			f.readBytes(buf.get(), size);
			DynamicJsonDocument json(768);
			auto error = deserializeJson(json, buf.get(), size);
			if (!error)
			{
				String username = json["user"];
				String pincode = "";
				if(json.containsKey("pincode"))
				{
					pincode = String((const char *)json["pincode"]);
				}
				for (int x = 1; x <= MAX_NUM_RELAYS; x++)
				{
					String theKey = String();
					if (x == 1)
						theKey = "acctype";
					else
						theKey = "acctype" + String(x);
					int AccType = json[theKey];
					item[theKey] = AccType;
				}
				unsigned long validsince = json.containsKey("validsince") ? json["validsince"] : 0;
				unsigned long validuntil = json["validuntil"];
				JsonObject userObj = json.as<JsonObject>();
				int roleId = roles_user_role_id(userObj);
				item["role_id"] = roleId;
				item["role_name"] = roles_name_by_id(roleId);
				item["username"] = username;
				item["validsince"] = validsince;
				item["validuntil"] = validuntil;
				item["pincode"] = pincode;
			}
		}
		i++;
		yield();
	}
	float pages = i / 10.0;
	root["haspages"] = ceil(pages);
	String userListStr;
	serializeJson(root, userListStr);
	AsyncWebSocketMessageBuffer *buffer = ws.makeBuffer((uint8_t *)userListStr.c_str(), userListStr.length());
	if (buffer)
	{
		if (client)
		{
#if defined(ESP8266)
			wsMessageTicker.once_ms_scheduled(50, [client, buffer]() {
				client->text(buffer);
				client->text("{\"command\":\"result\",\"resultof\":\"userlist\",\"result\": true}");
			});
#else
			client->text(buffer);
			client->text("{\"command\":\"result\",\"resultof\":\"userlist\",\"result\": true}");
#endif
		}
		else
		{
			ws.textAll("{\"command\":\"result\",\"resultof\":\"userlist\",\"result\": false}");
		}
	}
}

void ICACHE_FLASH_ATTR sendRoleList(AsyncWebSocketClient *client)
{
	if (roles_count() == 0)
	{
		roles_init_defaults((const char **)config.openingHours);
	}

	DynamicJsonDocument root(6144);
	root["command"] = "roleslist";
	root["max_roles"] = MAX_ACCESS_ROLES;
	JsonArray roles = root.createNestedArray("roles");
	roles_serialize(roles);

	String rolesStr;
	serializeJson(root, rolesStr);
	AsyncWebSocketMessageBuffer *buffer = ws.makeBuffer((uint8_t *)rolesStr.c_str(), rolesStr.length());
	if (buffer)
	{
		if (client)
		{
			client->text(buffer);
		}
		else
		{
			ws.textAll(buffer);
		}
	}
}

void ICACHE_FLASH_ATTR sendStatus(AsyncWebSocketClient *client)
{
	EspRfidFSInfo fsinfo;
	if (!espRfidSpiffsInfo(fsinfo))
	{
#ifdef DEBUG
		Serial.print(F("[ WARN ] Error getting info on SPIFFS"));
#endif
	}
	DynamicJsonDocument root(768);
	root["command"] = "status";
	root["firmware_target"] = ESP_RFID_FIRMWARE_TARGET;
#if defined(ESP32)
	root["secure_reader_supported"] = true;
#else
	root["secure_reader_supported"] = false;
#endif
	root["heap"] = ESP.getFreeHeap();
	root["chipid"] = String(espRfidChipId(), HEX);
	root["cpu"] = ESP.getCpuFreqMHz();
	root["sketchsize"] = ESP.getSketchSize();
	root["availsize"] = ESP.getFreeSketchSpace();
	root["availspiffs"] = fsinfo.totalBytes - fsinfo.usedBytes;
	root["spiffssize"] = fsinfo.totalBytes;

	int h = uptimeSeconds / 3600;
	int rem = uptimeSeconds % 3600;
	int m = rem / 60;
	int s = rem % 60;
	char uptimebuffer[9];
	sprintf(uptimebuffer, "%02d:%02d:%02d", h, m, s);
	root["uptime"] = uptimebuffer;

	root["version"] = VERSION;
	root["hostname"] = espRfidHostname();

	IPAddress ipaddr;
	IPAddress gwaddr;
	IPAddress nmaddr;
	if (config.accessPointMode)
	{
		ipaddr = WiFi.softAPIP();
		gwaddr = WiFi.softAPIP();
		nmaddr = config.accessPointSubnetIp;
		root["ssid"] = WiFi.softAPSSID();
		root["dns"] = printIP(WiFi.softAPIP());
		root["mac"] = WiFi.softAPmacAddress();
	}
	else
	{
		ipaddr = WiFi.localIP();
		gwaddr = WiFi.gatewayIP();
		nmaddr = WiFi.subnetMask();
		root["ssid"] = WiFi.SSID();
		root["dns"] = printIP(WiFi.dnsIP());
		root["mac"] = WiFi.macAddress();
	}

	root["ip"] = printIP(ipaddr);
	root["gateway"] = printIP(gwaddr);
	root["netmask"] = printIP(nmaddr);

	String statusStr;
	serializeJson(root, statusStr);
	AsyncWebSocketMessageBuffer *buffer = ws.makeBuffer((uint8_t *)statusStr.c_str(), statusStr.length());
	if (buffer)
	{
		if (client)
		{
			client->text(buffer);
		}
		else
		{
			ws.textAll(buffer);
		}
	}
}

void ICACHE_FLASH_ATTR printScanResult(int networksFound)
{
	// sort by RSSI
	int n = networksFound;
	int indices[n];
	int skip[n];
	for (int i = 0; i < networksFound; i++)
	{
		indices[i] = i;
	}
	for (int i = 0; i < networksFound; i++)
	{
		for (int j = i + 1; j < networksFound; j++)
		{
			if (WiFi.RSSI(indices[j]) > WiFi.RSSI(indices[i]))
			{
				std::swap(indices[i], indices[j]);
				std::swap(skip[i], skip[j]);
			}
		}
	}
	DynamicJsonDocument root(512);
	root["command"] = "ssidlist";
	JsonArray scan = root.createNestedArray("list");
	for (int i = 0; i < 5 && i < networksFound; ++i)
	{
		JsonObject item = scan.createNestedObject();
		item["ssid"] = WiFi.SSID(indices[i]);
		item["bssid"] = WiFi.BSSIDstr(indices[i]);
		item["rssi"] = WiFi.RSSI(indices[i]);
		item["channel"] = WiFi.channel(indices[i]);
		item["enctype"] = WiFi.encryptionType(indices[i]);
#if defined(ESP8266)
		item["hidden"] = WiFi.isHidden(indices[i]) ? true : false;
#else
		item["hidden"] = false;
#endif
	}
	String scanStr;
	serializeJson(root, scanStr);
	AsyncWebSocketMessageBuffer *buffer = ws.makeBuffer((uint8_t *)scanStr.c_str(), scanStr.length());
	if (buffer)
	{
		ws.textAll(buffer);
	}
	WiFi.scanDelete();
}

void ICACHE_FLASH_ATTR sendTime(AsyncWebSocketClient *client)
{
	DynamicJsonDocument root(512);
	root["command"] = "gettime";
	root["epoch"] = epoch;
	String timeStr;
	serializeJson(root, timeStr);
	AsyncWebSocketMessageBuffer *buffer = ws.makeBuffer((uint8_t *)timeStr.c_str(), timeStr.length());
	if (buffer)
	{
		if (client)
		{
			client->text(buffer);
		}
		else
		{
			ws.textAll(buffer);
		}
	}
}
